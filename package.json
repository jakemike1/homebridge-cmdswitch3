{
  "name": "homebridge-cmdswitch3",
  "version": "1.0.0-beta.6",
  "description": "Local shell and remote SSH switches and dimmers for Homebridge 2. Maintained cmdSwitch2 successor with sequential commands and optional quiet logging.",
  "main": "index.js",
  "license": "Apache-2.0",
  "author": "Luis Iam",
  "contributors": [
    "homebridge-cmdswitch2 contributors",
    "normen",
    "joepool",
    "cmdSwitch3 maintenance contributors"
  ],
  "keywords": [
    "homebridge-plugin",
    "cmdswitch",
    "cmdswitch2",
    "cmdswitch3",
    "command-switch",
    "shell",
    "ssh",
    "openssh",
    "ssh-switch",
    "ssh-commands",
    "remote-control",
    "shell-command",
    "switch",
    "dimmer",
    "supports-hap"
  ],
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^2.0.0"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "files": [
    "index.js",
    "config.js",
    "command-runner.js",
    "switch-controller.js",
    "config.schema.json",
    "README.md",
    "MIGRATION.md",
    "NOTICE",
    "LICENSE",
    "homebridge-ui/public",
    "TESTING.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.cjs test/*.test.mjs",
    "test:hb2": "node --test test/homebridge.test.mjs",
    "test:package": "node scripts/package-smoke.cjs",
    "check": "node scripts/check.cjs && node scripts/build-ui.cjs --check",
    "format:check": "prettier --check *.js *.json *.md scripts test/*.cjs test/*.mjs homebridge-ui/public/index.html homebridge-ui/public/settings.*",
    "build": "npm run check && npm test",
    "build:ui": "node scripts/build-ui.cjs",
    "preview": "node scripts/preview.cjs"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "homebridge": "2.4.0",
    "jsdom": "26.1.0",
    "prettier": "3.5.3"
  },
  "displayName": "cmdSwitch3",
  "homepage": "https://github.com/jakemike1/homebridge-cmdswitch3#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakemike1/homebridge-cmdswitch3.git"
  },
  "bugs": {
    "url": "https://github.com/jakemike1/homebridge-cmdswitch3/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  }
}
